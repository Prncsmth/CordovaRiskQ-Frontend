{
  "expo": {
    "name": "Cordova RiskQ",
    "slug": "cordova-riskq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/riskq.png",
    "scheme": "cordovariskq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cordovariskq.app"
    },
    "android": {
      "package": "com.cordovariskq.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground-riskq.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/riskq.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/riskq.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Cordova RiskQ to use your location to show nearby evacuation centers on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cordova RiskQ to access your photos so you can set a profile picture.",
          "cameraPermission": "Allow Cordova RiskQ to use your camera so you can take a profile picture."
        }
      ],
      "@rnmapbox/maps",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.554660920363-fs5jb9tm7umukhc6m4na52j3t9olu635"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C8102E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6db71fd-e759-43b6-836a-b76e03519d41"
      }
    }
  }
}
